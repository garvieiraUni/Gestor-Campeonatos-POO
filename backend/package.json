{
  "name": "gestor-campeonatos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Gestor de Campeonatos (NestJS + POO)",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/infra/persistence/postgres/migracoes','dist/infra/persistence/postgres/migracoes',{recursive:true})\"",
    "start": "node dist/main.js",
    "db:migrate": "ts-node --transpile-only src/infra/persistence/postgres/migrar.ts",
    "adm:promover": "ts-node --transpile-only src/infra/persistence/postgres/promover-adm.ts",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:e2e": "jest test/e2e",
    "test:integracao": "jest test/integracao --runInBand",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "src/application/**/*.ts",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "gestor-campeonatos": "file:..",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
