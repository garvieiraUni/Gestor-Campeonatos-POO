# memoria = roda sem banco (ótimo para desenvolver e para a demo)
# postgres = usa o PostgreSQL do docker-compose
PERSISTENCIA=memoria
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campeonatos
JWT_SECRET=troque-este-segredo
PORT=3000
# cria o usuário demo@campeonatos.dev / demo123 e 3 campeonatos de exemplo
SEED_DEMO=true
